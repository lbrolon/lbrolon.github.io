---
layout: default
---
{% unless site.data.resume %}
  <div class="post">
    <header class="post-header">
      <h1 class="post-title">{{ page.title }}</h1>
    </header>
    <p>No resume data found.</p>
  </div>
{% else %}

<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}
      {% if page.cv_pdf %}
        <a href="{{ page.cv_pdf | prepend: 'assets/pdf/' | relative_url }}" target="_blank" rel="noopener noreferrer" class="float-right">
          <i class="fa-solid fa-file-pdf"></i>
        </a>
      {% endif %}
    </h1>
  </header>

  <article>
    <div class="cv">
      {% for data in site.data.resume %}
        {% assign section_title = data[0] | capitalize %}
        {% for item in site.jsonresume %}
          {% if item.id == data[0] %}
            {% assign section_title = item.name %}
          {% endif %}
        {% endfor %}

        {% if data[1].size > 0 %}
          <a class="anchor" id="{{ data[0] }}"></a>
          <div class="card mt-3 p-3">
            <h3 class="card-title font-weight-medium">{{ section_title }}</h3>
            <div>
              {% case data[0] %}
                {% when 'basics' %}{% include resume/basics.liquid %}
                {% when 'education' %}{% include resume/education.liquid %}
                {% when 'work' %}{% include resume/work.liquid %}
                {% when 'volunteer' %}{% include resume/volunteer.liquid %}
                {% when 'projects' %}{% include resume/projects.liquid %}
                {% when 'awards' %}{% include resume/awards.liquid %}
                {% when 'skills' %}{% include resume/skills.liquid %}
                {% when 'publications' %}{% include resume/publications.liquid %}
                {% when 'languages' %}{% include resume/languages.liquid %}
                {% when 'academicInterests' %}{% include resume/academicInterests.liquid %}
                {% when 'otherInterests' %}{% include resume/otherInterests.liquid %}
                {% when 'scientificInvolvement' %}{% include resume/scientificInvolvement.liquid %}
                {% when 'certificates' %}{% include resume/certificates.liquid %}
                {% when 'references' %}{% include resume/references.liquid %}
              {% endcase %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </article>
</div>

{% endunless %}
