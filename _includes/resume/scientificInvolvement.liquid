<div class="list-groups">
  {% assign section = site.data.resume.scientificInvolvement %}
  {% for content in section %}
    <div class="list-group col-md-12">
      <table class="table-cv list-group-table">
        <tbody>
          <tr>
            <td class="list-group-category">{{ content.date }}</td>
            <td class="list-group-name"><b>{{ content.description }}</b></td>
          </tr>
        </tbody>
      </table>
    </div>
  {% endfor %}
</div>
