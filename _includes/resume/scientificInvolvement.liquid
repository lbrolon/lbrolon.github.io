<ul class="card-text font-weight-light list-group list-group-flush">
  {% assign scientific = site.data.resume.scientificInvolvement | sort: 'endDate' | reverse %}
  {% for content in scientific %}
    <li class="list-group-item">
      <div class="row">
        <div class="col-xs-2 col-sm-2 col-md-2 text-center date-column">
          {% if content.startDate %}
            {% assign startYear = content.startDate | slice: 0, 4 %}
            {% if content.endDate and content.endDate != '' %}
              {% assign endYear = content.endDate | slice: 0, 4 %}
            {% else %}
              {% assign endYear = 'Present' %}
            {% endif %}

            {% if startYear == endYear %}
              {% assign date = startYear %}
            {% else %}
              {% assign date = startYear | append: '–' | append: endYear %}
            {% endif %}
          {% else %}
            {% assign date = '' %}
          {% endif %}

          <table class="table-cv">
            <tbody>
              <tr>
                <td>
                  <span class="badge font-weight-bold danger-color-dark text-uppercase align-middle" style="min-width: 75px">
                    {{ date }}
                  </span>
                </td>
              </tr>
              {% if content.location and content.location != '' %}
                <tr>
                  <td>
                    <p class="location">
                      <i class="fa-solid fa-location-dot iconlocation"></i>
                      {{ content.location }}
                    </p>
                  </td>
                </tr>
              {% endif %}
            </tbody>
          </table>
        </div>

        <div class="col-xs-10 col-sm-10 col-md-10 mt-2 mt-md-0">
          <h6 class="title font-weight-bold ml-1 ml-md-4">
            {{ content.name }}
          </h6>
          {% if content.summary %}
            <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem; font-style: italic">
              {{ content.summary }}
            </h6>
          {% endif %}
          {% if content.highlights %}
            <ul class="items">
              {% for item in content.highlights %}
                <li><span class="item">{{ item }}</span></li>
              {% endfor %}
            </ul>
          {% endif %}
        </div>
      </div>
    </li>
  {% endfor %}
</ul>
